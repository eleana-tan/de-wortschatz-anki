# Required (non-empty): Authorization: Bearer <SECURE_API_KEY> for /capture and /export.
# The API refuses to start if this is missing, blank, or whitespace-only.
# Generate e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECURE_API_KEY=change-me-to-a-long-random-string

# SQLite path (created automatically)
DATABASE_PATH=./data/wortschatz.db

# Gemini (google-genai / gemini-3.8-flash). Optional: enrichment works offline
# without a key (dict.cc gloss + gender only; example_sentence / plural left
# empty). Set GOOGLE_API_KEY for phonetic cleanup, plurals, and examples.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anki deck metadata
ANKI_DECK_NAME=German Wortschatz
ANKI_MODEL_NAME=German Wortschatz Card
EXPORT_DIR=./exports

# Uvicorn (optional; used by README run commands)
HOST=0.0.0.0
PORT=8000
